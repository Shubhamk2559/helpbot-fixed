# Main (manager) bot token from BotFather
MAIN_BOT_TOKEN=

# Tumhara Telegram numeric user ID (sirf tum main bot chala sakoge)
OWNER_ID=

# MongoDB Atlas connection string
MONGO_URI=
DB_NAME=filebot

# Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=

# Render service ka public URL, e.g. https://myfilebot.onrender.com (no trailing slash)
BASE_URL=

# Koi bhi lamba random string
WEBHOOK_SECRET=

# Private channels ke IDs (-100 se shuru)
PRIMARY_CHANNEL=
BACKUP_CHANNEL=

# Health check interval seconds (default 300)
HEALTH_INTERVAL=300

# Koyeb: Dockerfile builder, port 8000 (KOYEB.md dekho)
# Render start command:
# uvicorn main:app --host 0.0.0.0 --port $PORT

# ---------------- Auto Posting (Control Center -> 🤖 Auto Posting) ----------------
# Sab OPTIONAL. Token / Mongo / owner HelpBot wale hi use hote hain (MAIN_BOT_TOKEN, MONGO_URI, OWNER_ID).
# Data alag Mongo database me jata hai: <DB_NAME>_autoposter  (badalna ho to AP_DB_NAME)
# AP_DB_NAME=
# Schedule / logs ka timezone (default Asia/Kolkata)
# TIMEZONE=Asia/Kolkata
# Destructive actions (wipe/remove) ke liye password; khali = password nahi
# ADMIN_PASSWORD=
# Source channel se import kiye posts ki safe copy yahan rakhi jati hai (bot is channel me admin ho)
# VAULT_CHAT_ID=
# Owner ke alawa aur admins (comma separated numeric IDs)
# AP_EXTRA_ADMIN_IDS=
# Naye target ke defaults
# DEFAULT_INTERVAL_MINUTES=180
# DEFAULT_BATCH_SIZE=5
# DEFAULT_START_TIME=00:00
# DEFAULT_END_TIME=21:00
# DEFAULT_DAYS=0,1,2,3,4,5,6
# SCAN_INTERVAL_SECONDS=30
# RETRY_ATTEMPTS=3
# POST_GAP_SECONDS=1
# LOG_RETENTION_DAYS=14

# ---------------- Smart Ads (AdsGram + Tads.me + Monetag) ----------------
# Off by default: the original Monetag-only flow runs unless this is true.
SMART_ADS_ENABLED=false
# Bearer token for /admin/ads (dashboard + API). Unset => admin endpoints return 404.
ADS_ADMIN_TOKEN=
# AdsGram: BlockID of a *Reward* unit (partner.adsgram.ai)
ADSGRAM_BLOCK_ID=
# Long random string YOU invent (>=24 chars). Put the same value in the AdsGram unit's Reward URL:
#   https://<your-host>/api/adsgram/reward?secret=<this value>&userid=[userId]
# Never expose it to the browser. Without it AdsGram rewards are only client-attested (and blocked by default).
ADSGRAM_REWARD_SECRET=
ADSGRAM_DEBUG=false
# Tads.me: fullscreen widget ID
TADS_WIDGET_ID=
TADS_DEBUG=false
# Tads documents no server-side reward verification. false (default) => Tads is never served.
# true => Tads completion is trusted from the browser callback (spoofable) - your risk.
TADS_ALLOW_CLIENT_REWARD=false
# Optional tuning
# ADS_UNSHOWN_LOCK_SECONDS=25    # an attempt that never displayed frees the user's ad slot after this long
# ADS_SHOWN_LOCK_SECONDS=180     # a displayed ad holds the slot this long (video + verification wait)
# SESSION_TTL=1800               # Mini App session lifetime (Mongo TTL index on sessions.created)
